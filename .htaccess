<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keamanan Ekstra: Blokir akses langsung ke file sensitif
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|artisan) - [F,L,NC]

    # Teruskan semua request ke direktori public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
